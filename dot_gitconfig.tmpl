[user]
    name = André Walker
    email = {{ .email }}
[color]
    diff = true
    status = true
    branch = true
    interactive = true
    ui = true
    pager = true
[core]
    excludesfile = ~/.gitignore
    warnambiguousrefs = true
    whitespace = fix,-indent-with-non-tab,trailing-space,cr-at-eol
[push]
    default = simple
    autoSetupRemote = true
[pull]
    rebase = true
[init]
    defaultBranch = main
[commit]
    verbose = true
